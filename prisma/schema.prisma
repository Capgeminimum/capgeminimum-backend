datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Player {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  gamesAsP1 Game[]   @relation("Player1")
  gamesAsP2 Game[]   @relation("Player2")
  wonGames  Game[]   @relation("Winner")
  tournaments Tournament[]
}

model Tournament {
  id          Int      @id @default(autoincrement())
  name        String
  status      String   @default("pending")
  players     Player[]
  games       Game[]
  winnerId    Int?
  createdAt   DateTime @default(now())
}

model Game {
  id           Int        @id @default(autoincrement())
  round        Int
  status       String     @default("pending")

  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  tournamentId Int

  player1      Player?    @relation("Player1", fields: [player1Id], references: [id])
  player1Id    Int?

  player2      Player?    @relation("Player2", fields: [player2Id], references: [id])
  player2Id    Int?

  winner       Player?    @relation("Winner", fields: [winnerId], references: [id])
  winnerId     Int?


  nextGame     Game?      @relation("NextMatch", fields: [nextGameId], references: [id])
  nextGameId   Int?
  previousGames Game[]    @relation("NextMatch")
}