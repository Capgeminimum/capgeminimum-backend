// URL de connexion gérée dans prisma.config.ts (Prisma 7)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
}

model player {
  id              Int      @id @default(autoincrement())
  username        String   @unique
  password        String
  email           String   @unique
  phone           String   @unique
  admin           Boolean  @default(false)
  elo             Int      @default(1000)
  looses          Int      @default(0)
  wins            Int      @default(0)
  winrate         Float    @default(0.0)
  tournament_wins Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model games {
  id            Int      @id @default(autoincrement())
  id_tournament Int?
  id_player1    Int
  id_player2    Int
  score_player1 Int
  score_player2 Int
  played_at     DateTime @default(now())
  winner        Int?
  status        String   @default("pending")
  round         Int      @default(1)
}

model tournament {
  id              Int      @id @default(autoincrement())
  nb_participants Int
  user_id         Int
  winner          String
  id_winner       Int
  elo_winner      Int
  duo             Boolean  @default(false)
  date            DateTime @default(now())
  status          String   @default("pending")
}

model participant {
  id            Int @id @default(autoincrement())
  tournament_id Int
  user_id       Int
}
